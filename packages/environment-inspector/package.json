{
  "name": "@fde-lab/environment-inspector",
  "version": "0.1.7",
  "files": [
    "dist"
  ],
  "bin": {
    "fde-environment-inspector": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-python",
    "copy-python": "mkdir -p dist/python && cp -r ../../fde_lab ../../demo ../../pyproject.toml dist/python/ && find dist/python -name '__pycache__' -type d -exec rm -rf {} +"
  },
  "dependencies": {
    "@fde-lab/cli-core": "*",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "execa": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smg99/fde-lab.git",
    "directory": "packages/environment-inspector"
  },
  "homepage": "https://github.com/smg99/fde-lab/tree/main/packages/environment-inspector#readme",
  "bugs": {
    "url": "https://github.com/smg99/fde-lab/issues"
  },
  "keywords": [
    "fde-lab",
    "ai",
    "worker",
    "agent",
    "fde",
    "forward-deployed-engineer",
    "environment-inspector",
    "environment",
    "inspection",
    "validation",
    "configuration",
    "audit",
    "health-check"
  ]
}
