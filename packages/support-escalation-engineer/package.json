{
  "name": "@fde-lab/support-escalation-engineer",
  "version": "0.1.2",
  "description": "FDE Lab - Support Escalation Engineer POC",
  "main": "dist/index.js",
  "bin": {
    "fde-support-escalation": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-python",
    "copy-python": "mkdir -p dist/python && cp -r ../../fde_lab ../../demo ../../pyproject.toml dist/python/ && find dist/python -name '__pycache__' -type d -exec rm -rf {} +"
  },
  "dependencies": {
    "@fde-lab/cli-core": "*",
    "chalk": "^4.1.2",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
