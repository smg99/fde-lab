    "type": "git",
    "url": "https://github.com/smg99/fde-lab.git",
    "directory": "packages/data-migration-engineer"
  },
  "homepage": "https://github.com/smg99/fde-lab/tree/main/packages/data-migration-engineer#readme",
  "bugs": {
    "url": "https://github.com/smg99/fde-lab/issues"
  },
  "keywords": [
    "fde-lab",
    "ai",
    "worker",
