{
  "name": "@fde-lab/customer-onboarding-engineer",
  "version": "0.1.3",
  "files": [
    "dist"
  ],
  "bin": {
    "fde-customer-onboarding-engineer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-python",
    "copy-python": "mkdir -p dist/python && cp -r ../../fde_lab ../../demo ../../pyproject.toml dist/python/ && find dist/python -name '__pycache__' -type d -exec rm -rf {} +"
  },
  "dependencies": {
    "@fde-lab/cli-core": "*",
    "chalk": "^4.1.2",
    "commander": "^11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smg99/fde-lab.git",
    "directory": "packages/customer-onboarding-engineer"
  },
  "homepage": "https://github.com/smg99/fde-lab/tree/main/packages/customer-onboarding-engineer#readme",
  "bugs": {
    "url": "https://github.com/smg99/fde-lab/issues"
  },
  "keywords": [
    "fde-lab",
    "ai",
    "worker",
    "agent",
    "fde",
    "forward-deployed-engineer",
    "customer-onboarding-engineer",
    "customer-success",
    "onboarding",
    "provisioning",
    "tenant"
  ]
}
