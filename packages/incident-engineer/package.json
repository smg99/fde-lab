{
  "name": "@fde-lab/incident-engineer",
  "version": "0.1.7",
  "files": [
    "dist"
  ],
  "bin": {
    "fde-incident-engineer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-python",
    "copy-python": "mkdir -p dist/python && cp -r ../../fde_lab ../../demo ../../pyproject.toml dist/python/ && find dist/python -name '__pycache__' -type d -exec rm -rf {} +"
  },
  "dependencies": {
    "@fde-lab/cli-core": "^0.1.3",
    "chalk": "^4.1.2",
    "commander": "^11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smg99/fde-lab.git",
    "directory": "packages/incident-engineer"
  },
  "homepage": "https://github.com/smg99/fde-lab/tree/main/packages/incident-engineer#readme",
  "bugs": {
    "url": "https://github.com/smg99/fde-lab/issues"
  },
  "keywords": [
    "fde-lab",
    "ai",
    "worker",
    "agent",
    "fde",
    "forward-deployed-engineer",
    "incident-engineer",
    "incident",
    "incident-response",
    "on-call",
    "sre",
    "devops",
    "troubleshooting",
    "observability"
  ]
}
