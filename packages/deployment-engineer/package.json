{
  "name": "@fde-lab/deployment-engineer",
  "version": "0.1.2",
  "files": [
    "dist"
  ],
  "bin": {
    "fde-deployment-engineer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-python",
    "copy-python": "mkdir -p dist/python && cp -r ../../fde_lab ../../demo ../../pyproject.toml dist/python/ && find dist/python -name '__pycache__' -type d -exec rm -rf {} +",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fde-lab/cli-core": "0.1.5",
    "chalk": "^4.1.2",
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smg99/fde-lab.git",
    "directory": "packages/deployment-engineer"
  },
  "homepage": "https://github.com/smg99/fde-lab/tree/main/packages/deployment-engineer#readme",
  "bugs": {
    "url": "https://github.com/smg99/fde-lab/issues"
  },
  "keywords": [
    "fde-lab",
    "ai",
    "worker",
    "agent",
    "deployment-engineer"
  ]
}
